# GitHub token with read-only access to public repositories (fine-grained PAT, no extra scopes).
GITHUB_TOKEN=
# Elasticsearch (local dev: security disabled, bound to 127.0.0.1)
ES_URL=http://127.0.0.1:9200
ES_INDEX=issues
PORT=3187
# Public hosting only (leave unset locally): bind address, requests per minute per client, proxy hops
# HOST=0.0.0.0
# RATE_LIMIT_PER_MIN=30
# TRUST_PROXY=1
